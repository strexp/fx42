# FX42 environment template. Copy to .env and fill in production secrets.

NODE_ENV=production
FX42_MODE=production
DATABASE_PATH=/data/fx42.db
FX42_CONFIG_FILE=/config/fx42.yaml

NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters
NUXT_PUBLIC_BASE_URL=https://fx.gensokyo.dn42

# Secrets must match clientSecretEnv in YAML; providers may share an env var.
FX42_OIDC_OAUTH_DN42_CLIENT_SECRET=

# 32 random bytes, base64. Generate with: openssl rand -base64 32
FX42_ENCRYPTION_KEY=

SCAM_BASE_URL=https://scam.dn42
# Reserve account used for real deposits/withdrawals. The token is held by the
# operator in the environment; it is never stored in SQLite or bound to a user.
SCAM_RESERVE_IBAN=
SCAM_RESERVE_TOKEN=
BIQUOTE_REST_URL=https://biquote.io
BIQUOTE_HUB_URL=https://biquote.io/hubs/tick

FX42_ALLOW_RISK_CONFIG_CHANGE=0
FX42_CONTROL_SOCKET=/run/fx42/control.sock
LOG_LEVEL=info
# The Docker image already defaults this to 1 and embeds the DN42 root CA.
NODE_USE_SYSTEM_CA=1
METRICS_TOKEN=change-me
